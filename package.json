{
  "name": "create-audora-next",
  "version": "2.0.0",
  "description": "Create a new Audora Next.js app with one command",
  "keywords": [
    "create",
    "next",
    "nextjs",
    "bun",
    "starter",
    "template",
    "audora"
  ],
  "type": "module",
  "license": "MIT",
  "private": false,
  "scripts": {
    "test:local": "bash scripts/test-local.sh",
    "clean": "rm -rf node_modules .next .turbo",
    "publish:local": "bun run index.ts --blog"
  },
  "bin": {
    "create-audora-next": "./index.ts"
  },
  "files": [
    "index.ts",
    "templates",
    "assets"
  ],
  "devDependencies": {
    "@types/bun": "latest"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "ora": "^9.0.0",
    "picocolors": "^1.1.1"
  }
}
